#!/bin/bash
# Install the MayOS overlay into a freshly bootstrapped Debian root.
set -euo pipefail
if [[ $EUID != 0 || $# != 4 ]]; then
    echo 'Usage: package-root ROOT RELEASE MAYOS_DESKTOP ROOT_IMAGE' >&2
    exit 2
fi
root=$(realpath "$1")
release=$2
desktop=$(realpath "$3")
image=$(realpath -m "$4")
source_dir=$(dirname "$(realpath "$0")")
[[ $root != / && -f $root/etc/debian_version && ! -e $image ]]
[[ $release =~ ^[0-9]+\.[0-9]+\.[0-9]+(-beta\.[0-9]+|-pre[0-9]+)?$ ]]
install -D -m 0755 "$desktop" "$root/usr/bin/mayos-desktop"
install -D -m 0755 "$source_dir/disk.py" "$root/usr/sbin/mayos-linux-update"
install -D -m 0755 "$source_dir/install-firefox" "$root/usr/sbin/mayos-install-firefox"
for file in start-desktop desktop-session mount-home; do
    install -D -m 0755 "$source_dir/$file" "$root/usr/lib/mayos/$file"
done
for service in desktop home; do
    install -D -m 0644 "$source_dir/$service.service" "$root/etc/systemd/system/mayos-$service.service"
done
install -D -m 0644 "$source_dir/network.conf" "$root/etc/systemd/network/20-mayos-wired.network"
chroot "$root" useradd --uid 1000 --user-group --groups sudo --no-create-home --shell /bin/bash mayos
chroot "$root" passwd -l root
printf '%s\n' "$release" >"$root/etc/mayos-linux-release"
cat >"$root/etc/os-release" <<RELEASE
NAME=MayOS
PRETTY_NAME="MayOS Linux64 $release"
VERSION_ID="$release"
ID=mayos
ID_LIKE=debian
RELEASE
printf 'mayos\n' >"$root/etc/hostname"
printf '127.0.0.1 localhost\n127.0.1.1 mayos\n::1 localhost\n' >"$root/etc/hosts"
printf 'deb https://deb.debian.org/debian trixie main\ndeb https://security.debian.org/debian-security trixie-security main\n' >"$root/etc/apt/sources.list"
rm -f "$root/etc/apt/sources.list.d/debian.sources"
ln -sfn /run/systemd/resolve/stub-resolv.conf "$root/etc/resolv.conf"
systemctl --root="$root" enable mayos-desktop.service systemd-networkd.service systemd-resolved.service
# Alias the kernel and initramfs already generated by Debian packages.
kernel=$(find "$root/boot" -maxdepth 1 -name 'vmlinuz-*' -print | sort -V | tail -n1)
suffix=${kernel##*/vmlinuz-}
test -s "$kernel" && test -s "$root/boot/initrd.img-$suffix"
ln -f "$kernel" "$root/boot/mayos-linux"
ln -f "$root/boot/initrd.img-$suffix" "$root/boot/mayos-initrd"
truncate -s 0 "$root/etc/machine-id"
rm -f "$root/var/lib/dbus/machine-id"
chroot "$root" apt-get clean
rm -f "$root"/var/lib/apt/lists/*_Packages "$root"/var/lib/apt/lists/*_InRelease
truncate -s 1536M "$image"
mke2fs -q -F -t ext4 -d "$root" -L MayOSLinux "$image"
e2fsck -fn "$image"
