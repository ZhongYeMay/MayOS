# BIOS and x86_64 UEFI use the same menu; kernels have separate boot protocols.
set timeout_style=menu
set timeout=5
set default=mayos
set gfxmode=1024x768x32,1024x768,800x600x32,800x600,640x480x32,640x480,auto
insmod all_video
insmod cpuid

serial --unit=0 --speed=115200
terminal_input console serial
terminal_output console serial

menuentry "MayOS - custom kernel (desktop)" --id mayos {
    set gfxpayload=keep
    multiboot /boot/mayos.elf
    boot
}

if cpuid -l; then
menuentry "Linux @LINUX_VERSION@ - desktop (x86_64)" --id linux {
    set gfxpayload=keep
    linux /boot/linux/bzImage console=tty0 console=ttyS0,115200 rdinit=/init mayos.desktop=1 panic=10
    initrd /boot/linux/initramfs.cpio.gz
    boot
}

menuentry "Linux @LINUX_VERSION@ - rescue shell (x86_64)" --id linux-rescue {
    # EFI has no legacy VGA text mode; Linux fbcon supplies the rescue console.
    set gfxpayload=keep
    linux /boot/linux/bzImage console=tty0 console=ttyS0,115200 rdinit=/init mayos.desktop=0 panic=10
    initrd /boot/linux/initramfs.cpio.gz
    boot
}
menuentry "Linux @LINUX_VERSION@ - compatibility rescue (x86_64)" --id linux-safe {
    set gfxpayload=keep
    linux /boot/linux/bzImage console=tty0 console=ttyS0,115200 rdinit=/init mayos.desktop=0 nomodeset noapic nolapic nosmp pci=nomsi panic=10
    initrd /boot/linux/initramfs.cpio.gz
    boot
}
fi
